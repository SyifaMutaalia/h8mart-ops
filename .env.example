N8N_VERSION=2.44.7
N8N_RUNNERS_AUTH_TOKEN=aien-lab-local-token

# Versi image pendukung
POSTGRES_VERSION=16.15-alpine
UPTIME_KUMA_VERSION=2.5.8
MOCK_API_IMAGE=node:24-alpine

# Kebijakan penyimpanan data eksekusi (sama dengan stack bersama Sesi 10)
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
EXECUTIONS_DATA_SAVE_ON_PROGRESS=false
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=336
EXECUTIONS_DATA_PRUNE_MAX_COUNT=10000

# PostgreSQL H8Mart (core.* dan ops.*)
PG_SUPERUSER_PASSWORD=h8mart-admin-lab
PG_READER_PASSWORD=mcp-reader-lab
PG_WRITER_PASSWORD=ops-writer-lab

# Mock API (Merchant Stock, Payment, Notification). Dikirim di header X-Api-Key.
MOCK_API_KEY=h8mart-mock-key

# Token Header Auth untuk Webhook event H8Mart (header X-H8Mart-Token)
WEBHOOK_TOKEN=h8mart-webhook-lab

OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

N8N_HOST_PORT=5690
PG_HOST_PORT=5440
MOCK_API_HOST_PORT=8080
KUMA_HOST_PORT=3011

# ---- Hanya untuk VPS (compose.vps.yaml). Di laptop biarkan terkomentar.
# DOMAIN_NAME=<nama-kalian>.duckdns.org
# SSL_EMAIL=<email-kalian>
# N8N_ENCRYPTION_KEY=<hasil: openssl rand -hex 32>
# CADDY_VERSION=2.11.7-alpine
