    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH payload AS (\n  SELECT $1::jsonb AS data\n),\nrequested AS (\n  SELECT\n    UPPER(TRIM(item->>'sku')) AS sku,\n    SUM((item->>'qty')::integer) AS qty_diminta\n  FROM payload,\n       LATERAL jsonb_array_elements(data->'items') AS item\n  GROUP BY UPPER(TRIM(item->>'sku'))\n),\nstock_check AS (\n  SELECT\n    r.sku,\n    r.qty_diminta,\n    p.product_id,\n    p.price,\n    COALESCE(s.qty, 0) AS stok_tersedia,\n    COALESCE(s.qty, 0) - r.qty_diminta AS sisa_stok\n  FROM requested r\n  LEFT JOIN core.products p ON p.sku = r.sku\n  LEFT JOIN core.merchant_stock s\n    ON s.product_id = p.product_id\n   AND s.merchant_id = (\n     SELECT data->>'merchant_id' FROM payload\n   )\n),\nsummary AS (\n  SELECT\n    COUNT(*) FILTER (\n      WHERE product_id IS NULL\n    ) AS produk_tidak_dikenal,\n    COUNT(*) FILTER (\n      WHERE stok_tersedia < qty_diminta\n    ) AS produk_kurang,\n    COUNT(*) FILTER (\n      WHERE sisa_stok BETWEEN 0 AND 2\n    ) AS produk_tipis,\n    COALESCE(SUM(qty_diminta * price), 0) + 8000\n      AS total_seharusnya,\n    jsonb_agg(\n      jsonb_build_object(\n        'sku', sku,\n        'product_id', product_id,\n        'qty_diminta', qty_diminta,\n        'stok_tersedia', stok_tersedia,\n        'sisa_stok', sisa_stok,\n        'unit_price', price\n      )\n    ) AS detail_stok\n  FROM stock_check\n)\nSELECT\n  data->>'order_id' AS order_id,\n  data->>'customer_id' AS customer_id,\n  data->>'merchant_id' AS merchant_id,\n  data->>'customer_note' AS customer_note,\n  m.zone,\n  s.detail_stok,\n  s.total_seharusnya,\n  CASE\n    WHEN m.merchant_id IS NULL\n      OR c.customer_id IS NULL\n      OR s.produk_tidak_dikenal > 0\n      OR (data->>'total_amount')::numeric\n         <> s.total_seharusnya\n      THEN 'invalid'\n    WHEN EXISTS (\n      SELECT 1 FROM core.orders o\n      WHERE o.order_id = data->>'order_id'\n    ) THEN 'duplicate'\n    WHEN s.produk_kurang > 0 THEN 'habis'\n    WHEN s.produk_tipis > 0 THEN 'tipis'\n    ELSE 'cukup'\n  END AS stok_status\nFROM payload\nCROSS JOIN summary s\nLEFT JOIN core.merchants m\n  ON m.merchant_id = data->>'merchant_id'\n AND m.active = TRUE\nLEFT JOIN core.customers c\n  ON c.customer_id = data->>'customer_id';\n",
        "options": {
          "queryBatching": "independently",
          "queryReplacement": "={{ [JSON.stringify($json.body)] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
