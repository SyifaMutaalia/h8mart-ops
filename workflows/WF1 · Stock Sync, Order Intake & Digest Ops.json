    {
      "parameters": {
        "jsCode": "const kpi = $('Hitung KPI Harian').first().json;\nconst mcpOutput = $input.all().map(item => item.json);\n\n// Membaca hasil MCP, termasuk JSON yang dikemas sebagai teks\nfunction ambilAlasan(data, depth = 0) {\n  if (data == null || depth > 8) return [];\n\n  if (typeof data === 'string') {\n    try {\n      return ambilAlasan(JSON.parse(data), depth + 1);\n    } catch {\n      return [];\n    }\n  }\n\n  if (Array.isArray(data)) {\n    return data.flatMap(item => ambilAlasan(item, depth + 1));\n  }\n\n  if (typeof data !== 'object') return [];\n\n  if ('alasan_batal' in data && 'jumlah_pembatalan' in data) {\n    return [data];\n  }\n\n  const keys = [\n    'response', 'content', 'structuredContent',\n    'result', 'data', 'output', 'rows', 'text'\n  ];\n\n  return keys.flatMap(key =>\n    key in data ? ambilAlasan(data[key], depth + 1) : []\n  );\n}\n\nif (mcpOutput.some(item => item.isError === true)) {\n  throw new Error('MCP Tool Alasan Batal gagal');\n}\n\nconst alasan = mcpOutput\n  .flatMap(item => ambilAlasan(item))\n  .map(item => ({\n    alasan_batal: String(item.alasan_batal),\n    jumlah_pembatalan: Number(item.jumlah_pembatalan)\n  }))\n  .filter(item => Number.isFinite(item.jumlah_pembatalan))\n  .sort((a, b) => b.jumlah_pembatalan - a.jumlah_pembatalan)\n  .slice(0, 5);\n\nconst angka = value =>\n  Number(value ?? 0).toLocaleString('id-ID');\n\nconst persen = value =>\n  Number(value ?? 0).toLocaleString('id-ID', {\n    minimumFractionDigits: 2,\n    maximumFractionDigits: 2\n  });\n\nconst alasanText = alasan.length\n  ? alasan.map((item, index) =>\n      `${index + 1}. ${item.alasan_batal.replace(/_/g, ' ')}: ${angka(item.jumlah_pembatalan)} order`\n    ).join('\\n')\n  : 'Tidak ada alasan pembatalan yang tercatat';\n\nconst pesan = [\n  '📊 H8MART — DAILY OPS DIGEST',\n  '',\n  `📅 Tanggal Data: ${String(kpi.tanggal_laporan).slice(0, 10)}`,\n  '',\n  '📦 RINGKASAN OPERASIONAL',\n  `Total Order: ${angka(kpi.total_order)}`,\n  `Order Batal: ${angka(kpi.order_batal)}`,\n  `Order Terkirim: ${angka(kpi.order_terkirim)}`,\n  `Order Tepat Waktu: ${angka(kpi.tepat_waktu)}`,\n  '',\n  '📈 KPI',\n  `Cancel Rate: ${persen(kpi.cancel_rate_pct)}%`,\n  `SLA 30 Menit: ${persen(kpi.sla_30_menit_pct)}%`,\n  '',\n  '🔎 ALASAN PEMBATALAN TERATAS',\n  alasanText,\n  '',\n  'Sumber: Database H8Mart melalui MCP'\n].join('\\n');\n\nreturn [{\n  json: {\n    ...kpi,\n    alasan_batal_teratas: alasan,\n    pesan_digest: pesan\n  }\n}];\n"
      },
