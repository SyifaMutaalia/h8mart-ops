      "name": "Routing Stok"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH input_data AS (\n    SELECT $1::jsonb AS data\n),\n\nnew_order AS (\n    INSERT INTO core.orders (\n        order_id,\n        customer_id,\n        merchant_id,\n        zone,\n        order_date,\n        created_at,\n        status,\n        cancel_reason,\n        total_amount,\n        payment_status,\n        customer_note\n    )\n    SELECT\n        data->>'order_id',\n        data->>'customer_id',\n        data->>'merchant_id',\n        data->>'zone',\n        (NOW() AT TIME ZONE 'Asia/Jakarta')::date,\n        NOW(),\n        'active',\n        NULL,\n        (data->>'total_seharusnya')::numeric,\n        'unpaid',\n        data->>'customer_note'\n    FROM input_data\n    WHERE data->>'stok_status' IN ('cukup', 'tipis')\n    ON CONFLICT (order_id) DO NOTHING\n    RETURNING order_id\n),\n\nnew_items AS (\n    INSERT INTO core.order_items (\n        order_id,\n        product_id,\n        qty,\n        unit_price\n    )\n    SELECT\n        o.order_id,\n        item.value->>'product_id',\n        (item.value->>'qty_diminta')::integer,\n        (item.value->>'unit_price')::numeric\n    FROM new_order o\n    CROSS JOIN input_data i\n    CROSS JOIN LATERAL\n        jsonb_array_elements(i.data->'detail_stok') AS item(value)\n    RETURNING product_id\n)\n\nSELECT\n    i.data->>'order_id' AS order_id,\n    CASE\n        WHEN EXISTS (SELECT 1 FROM new_order)\n        THEN 'created'\n        ELSE 'duplicate'\n    END AS save_status,\n    (SELECT COUNT(*) FROM new_items) AS item_count,\n    i.data->>'stok_status' AS stok_status,\n    (i.data->>'total_seharusnya')::numeric AS total_amount\nFROM input_data i;\n",
        "options": {
          "queryBatching": "independently",
          "queryReplacement": "={{ [JSON.stringify($json)] }}"
        }
      },
