    {
      "parameters": {
        "jsCode": "const hasil = [];\n\nfor (const item of $input.all()) {\n  const data = item.json;\n\n  // Lewati respons yang bukan data stok valid\n  if (!data.merchant_id || !Array.isArray(data.items)) {\n    continue;\n  }\n\n  for (const produk of data.items) {\n    const sku = String(produk.sku ?? \"\")\n      .trim()\n      .toUpperCase();\n\n    const qty = Number(produk.qty);\n\n    // Validasi SKU dan jumlah stok\n    if (\n      !sku ||\n      !Number.isInteger(qty) ||\n      qty < 0\n    ) {\n      throw new Error(\n        `Data stok tidak valid: ${data.merchant_id}`\n      );\n    }\n\n    hasil.push({\n      json: {\n        merchant_id: data.merchant_id,\n        sku,\n        qty,\n        synced_at: data.as_of ?? new Date().toISOString(),\n        ada_stok: true\n      }\n    });\n  }\n}\n\n// Jika tidak ada data stok yang berhasil dinormalisasi\nif (hasil.length === 0) {\n  return [{\n    json: {\n      ada_stok: false,\n      row_count: 0\n    }\n  }];\n}\n\n// Tambahkan jumlah total baris ke setiap item\nreturn hasil.map(item => ({\n  json: {\n    ...item.json,\n    row_count: hasil.length\n  }\n}));\n"
      },
