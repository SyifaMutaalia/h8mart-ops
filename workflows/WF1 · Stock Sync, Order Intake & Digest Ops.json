        "jsCode": "const stok = $('Normalisasi Stok')\n  .all()\n  .map(item => item.json)\n  .filter(row => row.ada_stok === true);\n\nconst hasilUpsert = $input.all()\n  .map(item => item.json)\n  .filter(row => row.merchant_id && row.product_id);\n\nconst jumlahMerchant = $('Ambil Daftar Merchant').all().length;\n\nconst merchantBerhasil = new Set(\n  stok.map(row => row.merchant_id)\n).size;\n\nreturn [{\n  json: {\n    merchants_total: jumlahMerchant,\n    merchants_ok: merchantBerhasil,\n    rows_synced: hasilUpsert.length\n  }\n}];\n"
