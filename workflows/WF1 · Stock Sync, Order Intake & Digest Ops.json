    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH tanggal AS (\n    SELECT\n        hari_data_terakhir::date AS tanggal_laporan\n    FROM core.data_info\n    LIMIT 1\n),\n\nmetrik AS (\n    SELECT\n        t.tanggal_laporan,\n\n        COUNT(o.order_id) AS total_order,\n\n        COUNT(o.order_id) FILTER (\n            WHERE o.status IN ('cancelled', 'failed')\n        ) AS order_batal,\n\n        COUNT(o.order_id) FILTER (\n            WHERE o.status = 'delivered'\n        ) AS order_terkirim,\n\n        COUNT(o.order_id) FILTER (\n            WHERE o.status = 'delivered'\n            AND EXISTS (\n                SELECT 1\n                FROM core.deliveries d\n                WHERE d.order_id = o.order_id\n                  AND d.actual_minutes <= d.promised_minutes\n            )\n        ) AS tepat_waktu\n\n    FROM tanggal t\n    LEFT JOIN core.orders o\n        ON o.order_date = t.tanggal_laporan\n\n    GROUP BY t.tanggal_laporan\n)\n\nSELECT\n    tanggal_laporan,\n    total_order,\n    order_batal,\n    order_terkirim,\n    tepat_waktu,\n\n    COALESCE(\n        ROUND(\n            100.0 * order_batal\n            / NULLIF(total_order, 0),\n            2\n        ), 0\n    ) AS cancel_rate_pct,\n\n    COALESCE(\n        ROUND(\n            100.0 * tepat_waktu\n            / NULLIF(order_terkirim, 0),\n            2\n        ), 0\n    ) AS sla_30_menit_pct\n\nFROM metrik;\n",
        "options": {}
      },
