        "operation": "executeQuery",
        "query": "WITH input_telegram AS (\n    SELECT\n        $1::bigint AS chat_id,\n        COALESCE($2::text, '') AS pertanyaan\n)\n\nSELECT\n    i.chat_id,\n    i.pertanyaan,\n    t.merchant_id,\n    t.label,\n    (t.chat_id IS NOT NULL) AS chat_terdaftar\n\nFROM input_telegram i\n\nLEFT JOIN ops.telegram_merchants t\n    ON t.chat_id = i.chat_id;\n",
