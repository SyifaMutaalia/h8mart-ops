    {
      "parameters": {
        "jsCode": "const sumber = $('Ambil Hari Data Terakhir').first().json;\nconst hasilAgent = $input.first().json;\n\nlet ai = hasilAgent.output ?? hasilAgent;\n\nif (typeof ai === 'string') {\n  try {\n    ai = JSON.parse(ai);\n  } catch {\n    ai = {};\n  }\n}\n\nif (ai?.output && typeof ai.output === 'object') {\n  ai = ai.output;\n}\n\nconst valid =\n  typeof ai?.jawaban === 'string' &&\n  Array.isArray(ai?.data_dipakai) &&\n  typeof ai?.perlu_eskalasi === 'boolean' &&\n  Number.isFinite(Number(ai?.confidence));\n\nconst jawaban = valid ? ai.jawaban.trim() : '';\nconst confidence = valid ? Number(ai.confidence) : 0;\nconst dataDipakai = valid ? ai.data_dipakai : [];\n\nconst pertanyaan = String(sumber.question ?? '');\n\n// Permintaan di luar kewenangan asisten\nconst tindakanTerlarang =\n  /\\b(kompensasi|refund|voucher|prediksi)\\b/i.test(pertanyaan) ||\n  /\\b(ubah|turunkan|naikkan)\\s+harga\\b/i.test(pertanyaan);\n\n// Mendeteksi permintaan merchant lain\nconst idLain = (pertanyaan.match(/\\bM\\d{3}\\b/gi) || [])\n  .some(id => id.toUpperCase() !== sumber.merchant_id);\n\n// Mencegah janji kompensasi palsu pada respons\nconst janjiPalsu =\n  /\\b(akan|pasti)\\s+(membayar|memberikan|menerima|mendapat)\\b.{0,80}\\b(kompensasi|refund)\\b/i.test(jawaban) ||\n  /Rp\\s*5[.,]?000[.,]?000/i.test(jawaban);\n\nconst lolos =\n  valid &&\n  jawaban.length > 0 &&\n  confidence >= 0.75 &&\n  confidence <= 1 &&\n  dataDipakai.length > 0 &&\n  ai.perlu_eskalasi === false &&\n  !tindakanTerlarang &&\n  !idLain &&\n  !janjiPalsu;\n\nlet alasan = null;\n\nif (!valid) alasan = 'output_tidak_valid';\nelse if (idLain) alasan = 'akses_merchant_lain';\nelse if (tindakanTerlarang) alasan = 'di_luar_kewenangan';\nelse if (janjiPalsu) alasan = 'jawaban_tidak_aman';\nelse if (ai.perlu_eskalasi) alasan = 'eskalasi_dari_ai';\nelse if (confidence < 0.75) alasan = 'confidence_rendah';\nelse if (dataDipakai.length === 0) alasan = 'data_tidak_cukup';\n\nreturn [{\n  json: {\n    merchant_id: sumber.merchant_id,\n    question: sumber.question,\n    jawaban,\n    data_dipakai: dataDipakai,\n    confidence,\n    perlu_eskalasi: !lolos,\n    lolos_guardrail: lolos,\n    alasan\n  }\n}];\n"
      },
