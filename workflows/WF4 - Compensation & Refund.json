    {
      "parameters": {
        "jsCode": "const order = $input.first().json;\n\n// Kebijakan H8Mart\nconst REFUND_OTOMATIS_MAX = 100000;\nconst VOUCHER_RINGAN = 10000;\nconst VOUCHER_BERAT = 20000;\n\nconst event = String(order.event ?? '').trim();\nconst orderId = String(order.order_id ?? '').trim();\nconst paymentStatus = String(order.payment_status ?? '').toLowerCase();\nconst nominalOrder = Number(order.total_amount ?? 0);\nconst menitTerlambat = Number(order.minutes_late);\n\n// Validasi awal\nif (order.order_found !== true && order.order_found !== 'true') {\n  throw new Error(`WF4: Order ${orderId} tidak ditemukan`);\n}\n\nif (!['delivery.late', 'order.failed'].includes(event)) {\n  throw new Error(`WF4: Event tidak dikenal: ${event}`);\n}\n\nlet route = 'skip';\nlet keputusan = '';\nlet nominal = 0;\nlet perluApproval = false;\nlet alasan = '';\n\n// JALUR 1: VOUCHER KETERLAMBATAN\nif (event === 'delivery.late') {\n  if (!Number.isInteger(menitTerlambat) || menitTerlambat < 0) {\n    throw new Error(`WF4: minutes_late tidak valid untuk ${orderId}`);\n  }\n\n  if (menitTerlambat >= 1 && menitTerlambat <= 15) {\n    route = 'voucher';\n    keputusan = 'voucher_otomatis';\n    nominal = VOUCHER_RINGAN;\n    alasan = 'Keterlambatan 1–15 menit';\n  } else if (menitTerlambat <= 60 && menitTerlambat >= 16) {\n    route = 'voucher';\n    keputusan = 'voucher_otomatis';\n    nominal = VOUCHER_BERAT;\n    alasan = 'Keterlambatan 16–60 menit';\n  } else if (menitTerlambat > 60) {\n    route = 'escalate';\n    keputusan = 'eskalasi_ops';\n    alasan = 'Keterlambatan lebih dari 60 menit';\n  } else {\n    keputusan = 'tidak_ada_kompensasi';\n    alasan = 'Tidak ada keterlambatan';\n  }\n}\n\n// JALUR 2: REFUND ORDER GAGAL\nif (event === 'order.failed') {\n  if (paymentStatus === 'refunded') {\n    keputusan = 'sudah_refund';\n    alasan = 'Pembayaran sudah dikembalikan';\n  } else if (paymentStatus !== 'captured') {\n    keputusan = 'tidak_perlu_refund';\n    alasan = 'Pembayaran belum tertagih';\n  } else if (\n    !Number.isSafeInteger(nominalOrder) ||\n    nominalOrder <= 0\n  ) {\n    throw new Error(`WF4: Nominal refund tidak valid untuk ${orderId}`);\n  } else {\n    nominal = nominalOrder;\n    route = 'refund';\n\n    if (nominal <= REFUND_OTOMATIS_MAX) {\n      keputusan = 'refund_otomatis';\n      perluApproval = false;\n      alasan = 'Nominal di bawah atau sama dengan ambang';\n    } else {\n      keputusan = 'refund_perlu_approval';\n      perluApproval = true;\n      alasan = 'Nominal melebihi ambang refund otomatis';\n    }\n  }\n}\n\n// Kunci tetap untuk mencegah Payment diproses ganda\nconst jenisTindakan = event === 'delivery.late'\n  ? 'voucher'\n  : 'refund';\n\nconst idempotencyKey =\n  `h8mart-${jenisTindakan}-${orderId}`;\n\nreturn [{\n  json: {\n    ...order,\n    route,\n    keputusan,\n    nominal,\n    perlu_approval: perluApproval,\n    alasan_kebijakan: alasan,\n    ambang_refund: REFUND_OTOMATIS_MAX,\n    idempotency_key: idempotencyKey\n  }\n}];\n"
      },
