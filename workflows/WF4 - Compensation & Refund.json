      "parameters": {
        "operation": "executeQuery",
        "query": "WITH baru AS (\n  INSERT INTO ops.compensations (\n    order_id, kind, amount,\n    idempotency_key, status, note\n  )\n  VALUES (\n    $1, 'voucher', $2::numeric,\n    $3, 'pending', $4\n  )\n  ON CONFLICT (idempotency_key) DO NOTHING\n  RETURNING\n    comp_id, order_id, amount,\n    idempotency_key, status\n)\nSELECT *, TRUE AS is_new FROM baru\nUNION ALL\nSELECT\n  comp_id, order_id, amount,\n  idempotency_key, status,\n  FALSE AS is_new\nFROM ops.compensations\nWHERE idempotency_key = $3\n  AND NOT EXISTS (SELECT 1 FROM baru)\nLIMIT 1;\n",
        "options": {
