      "parameters": {
        "operation": "executeQuery",
        "query": "WITH event_data AS (\n    SELECT $1::jsonb AS payload\n)\n\nSELECT\n    e.payload->>'event' AS event,\n    e.payload->>'order_id' AS order_id,\n\n    e.payload->>'reason' AS event_reason,\n\n    CASE\n        WHEN e.payload->>'minutes_late' ~ '^[0-9]+$'\n        THEN (e.payload->>'minutes_late')::integer\n        ELSE NULL\n    END AS minutes_late,\n\n    o.customer_id,\n    o.merchant_id,\n    o.zone,\n    o.order_date,\n    o.status AS order_status,\n    o.payment_status,\n    o.total_amount,\n\n    d.promised_minutes,\n    d.actual_minutes,\n\n    (o.order_id IS NOT NULL) AS order_found\n\nFROM event_data e\n\nLEFT JOIN core.orders o\n    ON o.order_id = e.payload->>'order_id'\n\nLEFT JOIN core.deliveries d\n    ON d.order_id = o.order_id;\n",
        "options": {
          "queryBatching": "independently",
          "queryReplacement": "={{ [JSON.stringify($json.body)] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        80,
        0
      ],
      "id": "fe901769-a324-4241-a116-e530dc96c07a",
      "name": "Ambil Order",
      "credentials": {
        "postgres": {
          "id": "ZHuenz7qvUy2bJbi",
          "name": "Postgres account"
        }
      }
