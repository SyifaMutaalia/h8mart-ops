    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nconst execution = data.execution ?? {};\nconst error = execution.error ?? data.trigger?.error ?? {};\n\nconst workflowName =\n  data.workflow?.name ?? 'Tidak diketahui';\n\nconst nodeName =\n  execution.lastNodeExecuted ??\n  error.node?.name ??\n  'Tidak diketahui';\n\nconst errorMessage = String(\n  error.message ??\n  error.cause?.message ??\n  'Pesan error tidak tersedia'\n);\n\nconst keyMatch = errorMessage.match(\n  /\\b(?:business_key|order_id|merchant_id)\\s*[:=]\\s*([A-Za-z0-9_-]+)/i\n);\n\nconst businessKey = keyMatch?.[1] ?? 'Tidak tersedia';\n\nconst waktu = new Date().toLocaleString('id-ID', {\n  timeZone: 'Asia/Jakarta',\n  hour12: false\n});\n\nconst pesan = [\n  '🚨 H8MART - WORKFLOW ERROR',\n  '',\n  `Workflow: ${workflowName}`,\n  `Node: ${nodeName}`,\n  `Waktu: ${waktu} WIB`,\n  `Business Key: ${businessKey}`,\n  `Error: ${errorMessage.slice(0, 300)}`,\n  `Execution: ${execution.url ?? '-'}`\n].join('\\n');\n\nreturn [\n  {\n    json: {\n      workflow: workflowName,\n      node: nodeName,\n      waktu,\n      business_key: businessKey,\n      error_message: errorMessage,\n      execution_url: execution.url ?? null,\n      pesan\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
