    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "pythonNative",
        "pythonCode": "# Pola H8Mart x Day 5, native Python Code node.\nWORKFLOW_KRITIS = [\"WF1 · Stock Sync, Order Intake & Digest\", \"WF4 · Kompensasi & Refund\"]\ndata = _items[0][\"json\"]\nworkflow = data.get(\"workflow\") or {}\nexecution = data.get(\"execution\") or {}\ntrigger = data.get(\"trigger\") or {}\nsumber = execution if execution else trigger\nerror = sumber.get(\"error\") or {}\nnama = workflow.get(\"name\") or \"tidak diketahui\"\nerror_message = str(error.get(\"message\") or \"kegagalan tanpa pesan\")\nnode = str(sumber.get(\"lastNodeExecuted\") or \"trigger\")\nkey = \"-\"\nif error_message.startswith(\"[\") and \"]\" in error_message:\n    key = error_message[1:error_message.index(\"]\")]\nseverity = \"kritis\" if (nama in WORKFLOW_KRITIS or trigger or \"refund\" in node.lower() or \"stok\" in node.lower()) else \"rutin\"\nwaktu = data.get(\"waktu_wib\", \"-\")\nurl = sumber.get(\"url\") or \"-\"\ntindakan = \"Periksa execution, retry terkontrol, dan dead-letter\" if severity == \"kritis\" else \"Tinjau pada review log harian\"\npesan = \"[\" + severity.upper() + \"] \" + str(nama) + \"\\nNode: \" + node + \"\\nWaktu: \" + str(waktu) + \"\\nBusiness key: \" + key + \"\\nError: \" + error_message[:600] + \"\\nExecution: \" + str(url) + \"\\nTindakan: \" + tindakan\nreturn [{\"json\": {\"severity\": severity, \"workflow\": nama, \"node_gagal\": node, \"waktu_wib\": waktu, \"business_key\": key, \"error_message\": error_message[:600], \"execution_url\": url, \"tindakan\": tindakan, \"pesan\": pesan}}]\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        630,
        300
      ],
      "id": "e8430b57-8282-5e68-803a-6cd20ec2bf87",
      "name": "Susun Pesan Alert"
    },
